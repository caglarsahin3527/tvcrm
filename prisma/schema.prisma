generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String   @default("") // Hashed password
  role      String   // "SALES_REP", "SALES_MANAGER", "ADMIN", "VIEWER"
  target    Float    @default(500000) // Aylık Satış Hedefi (TL)
  phone     String?  @default("")
  avatar      String?      @default("")
  clients     Client[]
  workReports WorkReport[]
  createdAt   DateTime     @default(now())
}

model Client {
  id                  String   @id @default(uuid())
  firma_adi           String
  yetkili_kisi        String
  telefon             String
  eposta              String?  @default("")
  musteri_tipi        String   // "Kamu", "Kurumsal", "KOBİ", "Ajans", "Diğer"
  satis_temsilcisi_id String
  satis_temsilcisi    User     @relation(fields: [satis_temsilcisi_id], references: [id])
  sonraki_takip_tarihi DateTime
  deals               Deal[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([satis_temsilcisi_id])
  @@index([musteri_tipi])
  @@index([sonraki_takip_tarihi])
}

model Deal {
  id                     String    @id @default(uuid())
  musteri_id             String
  musteri                Client    @relation(fields: [musteri_id], references: [id], onDelete: Cascade)
  kanal                  String    // "Bi Kanal", "Sıfır TV"
  teklif_tutari          Float     @default(0)
  yayin_donemi           String    @default("")
  baslangic_tarihi       DateTime?
  bitis_tarihi           DateTime?
  tahmini_kapanis_tarihi DateTime?
  ihtimal_derecesi       String    @default("Orta") // "Kesin", "Yüksek", "Orta", "Düşük"
  asama                  String    @default("YENİ LEAD") // "YENİ LEAD", "GÖRÜŞME", "TEKLİF", "TAKİP", "PAZARLIK", "ONAY", "SATIŞ", "YAYIN", "TAHSİLAT"
  is_archived            Boolean   @default(false)
  not                    String    @default("")
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([musteri_id])
  @@index([kanal])
  @@index([asama])
  @@index([is_archived])
  @@index([createdAt])
}

model WorkReport {
  id                        String    @id @default(uuid())
  user_id                   String
  user                      User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  tarih                     DateTime  @default(now())
  kurum_adi                 String
  kurum_turu                String    // "Marka", "Ajans", "KOBİ", "Kamu"
  musteri_durumu            String    @default("Yeni Müşteri") // "Yeni Müşteri", "Mevcut"
  yetkili                   String
  yetkili_telefon           String    @default("") // Yetkilinin telefon numarası
  yetkili_eposta            String    @default("") // Yetkilinin e-posta adresi
  iletisim_turu             String    // "Telefon", "E-posta", "Yüzyüze Toplantı", "Dijital Toplantı", "Kurumsal Ziyaret"
  reklam_turu               String    @default("Reklam") // "Reklam", "Barter"
  tv_kanali                 String    @default("Bi Kanal") // "Bi Kanal", "Sıfır TV"
  gorusme_amaci             String    @default("") // Kiminle ne amaçla görüşüldüğü
  sonuc                     String    @default("") // Görüşme sonucu
  teklif_verildi            Boolean   @default(false)
  teklif_tutari             Float?    @default(0)
  teklif_ihtimal            String?   @default("") // "%25", "%50", "%75", "%100"
  satis_yapildi             Boolean   @default(false)
  satis_turu                String?   @default("") // "Spot Reklam", "Alt Bant Reklam", "Sponsorluk"
  satis_tutari              Float?    @default(0)
  kurumsal_ziyaret          Boolean   @default(false)
  rezervasyon_var           Boolean   @default(false)
  rezervasyon_gelen         Int?      @default(0)  // 1-100 arası rakam
  rezervasyon_turu          String?   @default("") // "Spot", "Alt Bant", "Sponsorluk", "Kamu Spotu"
  rezervasyon_fiyat_tipi    String?   @default("TEK_FIYAT") // "TEK_FIYAT", "PT_OPT"
  rezervasyon_opt_saniye    Int?      @default(0)
  rezervasyon_opt_fiyat     Float?    @default(0)
  rezervasyon_pt_saniye     Int?      @default(0)
  rezervasyon_pt_fiyat      Float?    @default(0)
  rezervasyon_birim_fiyat   Float?    @default(0)
  rezervasyon_toplam_saniye Int?      @default(0)
  rezervasyon_vade          String?   @default("") // "Nakit", "30 Gün", "60 Gün", "90 Gün", "120 Gün", "150 Gün", "180 Gün", "Özel"
  deal_id                   String?   // Otomatik oluşturulan fırsatın ID'sini tutar
  tamamlandi                Boolean   @default(false)
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@index([user_id])
  @@index([tarih])
  @@index([kurum_turu])
  @@index([tv_kanali])
  @@index([tamamlandi])
}